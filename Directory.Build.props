<Project>

    <!-- Language and framework settings live here so no project can silently opt out. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Version>2.0.0</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <Deterministic>true</Deterministic>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <ProductName>DupDetector</ProductName>
    </PropertyGroup>

    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Transitive auditing stays on. Advisories are suppressed by id, never wholesale. -->
    <PropertyGroup>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
    </PropertyGroup>

    <PropertyGroup>
        <!-- CA2007: console tool and test host; there is no synchronization context to capture. -->
        <NoWarn>$(NoWarn);CA2007</NoWarn>
        <!-- IDE0290 requires primary constructors; ATXCS037 forbids them. Automaticks wins. -->
        <NoWarn>$(NoWarn);IDE0290</NoWarn>
        <!-- IDE0066 requires a switch expression; ATXCS058 forbids the inline new inside one. -->
        <NoWarn>$(NoWarn);IDE0066</NoWarn>
        <!-- S3963 requires inline static field initialisers; ATXCS036 forbids them. Automaticks wins. -->
        <NoWarn>$(NoWarn);S3963</NoWarn>
        <!-- S1075: SARIF requires absolute informationUri/helpUri; the tool's own URLs are not environment specific. -->
        <NoWarn>$(NoWarn);S1075</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
        <PackageReference Include="Automaticks.CSharp.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Automaticks.Linq.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Automaticks.Reflection.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Automaticks.Diagnostics.CodeAnalysis.Analyzers" PrivateAssets="all" />
    </ItemGroup>

</Project>